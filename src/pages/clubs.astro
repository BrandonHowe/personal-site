---
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import { pageMeta } from "../config";

const page = await getEntry("pages", "clubs");
if (!page) throw new Error("Missing src/content/pages/clubs.md");
const { Content } = await render(page);
const { title } = pageMeta.clubs;
---

<Base title={title} description={page.data.description}>
  <PageHeader title={title} />
  <div class="prose page-intro">
    <Content />
  </div>
</Base>
