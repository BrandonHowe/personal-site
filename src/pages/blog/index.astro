---
import { getCollection, getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import { pageMeta } from "../../config";
import { isoDate, longDate } from "../../lib/dates";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const { title, meta } = pageMeta.blog;

const page = await getEntry("pages", "blog");
if (!page) throw new Error("Missing src/content/pages/blog.md");
const { Content: Intro } = await render(page);
---

<Base title={title} description={meta}>
  <PageHeader title={title} />

  <div class="prose page-intro">
    <Intro />
  </div>

  {
    posts.length > 0 ? (
      <ul class="annotated-list">
        {posts.map((post) => (
          <li class="annotated-list__item">
            <div class="annotated-list__row">
              <h2 class="annotated-list__title">
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </h2>
              <time
                class="annotated-list__meta"
                datetime={isoDate(post.data.date)}
              >
                {longDate(post.data.date)}
              </time>
            </div>
            {post.data.description && (
              <p class="annotated-list__note">{post.data.description}</p>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <div class="placeholder">
        <p>No posts yet.</p>
      </div>
    )
  }
</Base>
