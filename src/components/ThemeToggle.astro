---
// Zero-JS-framework theme toggle. The pre-paint script lives in Base.astro.
---

<button
  type="button"
  class="theme-toggle"
  id="theme-toggle"
  aria-label="Toggle dark mode"
  title="Toggle dark mode"
>
  {/* Both icons render; CSS cross-fades between them. */}
  <svg
    class="theme-toggle__icon theme-toggle__icon--sun"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4.2"></circle>
    <path
      d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6"
    ></path>
  </svg>
  <svg
    class="theme-toggle__icon theme-toggle__icon--moon"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20.5 14.4A8.5 8.5 0 1 1 9.6 3.5a6.8 6.8 0 0 0 10.9 10.9Z"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;

  const apply = (theme: string) => {
    root.setAttribute("data-theme", theme);
    root.style.colorScheme = theme;
  };

  // The button is a fresh element after every client-side navigation, so the
  // listener has to be attached again each time rather than once at load.
  function bindToggle() {
    const button = document.getElementById("theme-toggle");
    if (!button || button.dataset.bound) return;
    button.dataset.bound = "true";

    button.addEventListener("click", () => {
      const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
      apply(next);
      try {
        // Only an explicit choice is stored — otherwise the first visit would
        // pin the theme and stop tracking the OS.
        localStorage.setItem("theme", next);
      } catch {
        // Storage can be unavailable in private mode; the toggle still works.
      }
    });
  }

  // Fires on first load and after each client-side navigation.
  document.addEventListener("astro:page-load", bindToggle);

  // Keep following the OS setting until the visitor picks a side. Bound once
  // on window, so it survives navigations without stacking.
  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", (event) => {
      let chosen = null;
      try {
        chosen = localStorage.getItem("theme");
      } catch {
        // Ignore.
      }
      if (!chosen) apply(event.matches ? "dark" : "light");
    });
</script>
